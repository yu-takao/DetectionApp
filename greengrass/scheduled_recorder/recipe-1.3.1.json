{
  "RecipeFormatVersion": "2020-01-25",
  "ComponentName": "scheduled_recorder",
  "ComponentVersion": "1.3.1",
  "ComponentType": "aws.greengrass.generic",
  "ComponentDescription": "Scheduled recorder with MQTT config and schedule support (48kHz mono)",
  "ComponentPublisher": "Me",
  "ComponentConfiguration": {
    "DefaultConfiguration": {
      "enabled": false,
      "intervalSec": 3600,
      "durationSec": 10,
      "scheduleStartHour": 0,
      "scheduleEndHour": 24,
      "bucket": "recordings-kawasaki-city",
      "prefix": "phase1",
      "device": "plughw:CARD=Microphone,DEV=0",
      "accessControl": {
        "aws.greengrass.ipc.mqttproxy": {
          "scheduled_recorder:sub:1": {
            "policyDescription": "Subscribe to config topic",
            "operations": ["aws.greengrass#SubscribeToIoTCore"],
            "resources": ["cmd/*/recorder/config"]
          },
          "scheduled_recorder:pub:1": {
            "policyDescription": "Publish config ACK",
            "operations": ["aws.greengrass#PublishToIoTCore"],
            "resources": ["status/*/recorder/config"]
          }
        }
      }
    }
  },
  "ComponentDependencies": {
    "aws.greengrass.TokenExchangeService": {
      "VersionRequirement": ">=2.0.0 <3.0.0",
      "DependencyType": "HARD"
    }
  },
  "Manifests": [
    {
      "Platform": { "os": "linux" },
      "Lifecycle": {
        "Install": {
          "RequiresPrivilege": true,
          "script": "apt-get update -y && apt-get install -y ffmpeg; . /home/yu_takao/myenv/bin/activate; python3 -m pip install -q boto3 awsiotsdk awscrt || true"
        },
        "Run": {
          "RequiresPrivilege": true,
          "script": ". /home/yu_takao/myenv/bin/activate; python3 -u {artifacts:path}/scheduled_recorder.py"
        }
      },
      "Artifacts": [
        {
          "Uri": "s3://raspi-artifacts/scheduled_recorder/1.3.1/scheduled_recorder.py",
          "Unarchive": "NONE",
          "Permission": { "Read": "OWNER", "Execute": "NONE" }
        }
      ]
    }
  ]
}
